{
  "name": "gitlab-http-api-mcp",
  "version": "0.2.0",
  "description": "MCP server for GitLab over HTTP API (projects, issues, MRs, CI pipelines, jobs)",
  "type": "module",
  "main": "server.mjs",
  "bin": {
    "gitlab-http-api-mcp": "server.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "publish:npm": "npm publish --access public"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rkorablin/gitlab-http-api-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gitlab",
    "projects",
    "issues",
    "merge-requests",
    "pipelines",
    "ci",
    "http-api"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  }
}
